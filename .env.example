# ---------------------------------------------------------------------------
# Public site (all of these are just defaults - every value can be changed
# later from the admin panel)
# ---------------------------------------------------------------------------
DESTINATION_URL=https://example.com
REDIRECT_MODE=always
REDIRECT_DELAY_MS=0
SKIP_CRAWLERS=true
SITE_TITLE=My Site
SITE_NAME=My Site
META_DESCRIPTION=Welcome to my site.
OG_IMAGE=

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# URL path where the panel lives (domain.com/<ADMIN_PATH>). No link to it is
# ever rendered on the public site.
ADMIN_PATH=admin
# Password for the panel. Use something long and random.
ADMIN_PASSWORD=change-this-to-something-long
# Extra secret used to sign the login cookie (any long random string).
SESSION_SECRET=change-this-to-a-random-32-char-string

# ---------------------------------------------------------------------------
# Persistent storage (required in production, recommended everywhere)
# Either the Vercel KV or the Upstash Redis REST credentials work.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
